{
  "name": "jm-editor",
  "version": "0.0.1",
  "description": "의존성 없이 contenteditable로 직접 구현한 WYSIWYG 웹에디터",
  "license": "MIT",
  "author": "jinix55",
  "repository": "github:jinix55/JmEditor",
  "type": "module",
  "main": "dist/jm-editor.esm.js",
  "files": [
    "src",
    "dist",
    "examples",
    "server",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "editor",
    "wysiwyg",
    "contenteditable",
    "thymeleaf",
    "jsp",
    "react",
    "spring-boot"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "exports": {
    ".": {
      "import": "./dist/jm-editor.esm.js",
      "default": "./dist/jm-editor.min.js"
    },
    "./viewer": {
      "import": "./dist/jm-viewer.esm.js",
      "default": "./dist/jm-viewer.min.js"
    },
    "./css": "./dist/jm-editor.css",
    "./src/*": "./src/*"
  }
}
